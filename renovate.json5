{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'github>blogle/sdlc#v1'],
  enabledManagers: ['nix', 'github-actions', 'kubernetes', 'kustomize', 'flux', 'custom.regex'],
  dependencyDashboard: true,
  prConcurrentLimit: 2,
  branchConcurrentLimit: 2,
  labels: ['dependencies', 'kubernetes'],
  packageRules: [
    {
      matchManagers: ['kustomize'],
      matchPackageNames: ['blogle/dojo2', 'blogle/anvil'],
      enabled: false,
    },
    {
      matchManagers: ['kubernetes', 'kustomize'],
      matchPackageNames: [
        'ghcr.io/blogle/anvil',
        'ghcr.io/blogle/anvil-sandbox',
        'ghcr.io/blogle/anvil-nix-daemon',
      ],
      enabled: false,
    },
    {
      matchManagers: ['kustomize'],
      matchPackageNames: ['ghcr.io/blogle/dojo2'],
      matchFileNames: ['addrspace/apps/dojo/overlays/staging/kustomization.yaml'],
      enabled: false,
    },
    {
      matchManagers: ['kubernetes'],
      matchPackageNames: ['ghcr.io/blogle/dojo2'],
      matchFileNames: [
        'addrspace/apps/dojo/overlays/prod/pod-spec.patch.yaml',
        'addrspace/apps/dojo/overlays/staging/pod-spec.patch.yaml',
      ],
      enabled: false,
    },
    {
      matchManagers: ['kubernetes', 'kustomize'],
      matchPackageNames: ['blogle/dojo2', 'ghcr.io/blogle/dojo2'],
      matchFileNames: ['addrspace/apps/dojo/overlays/prod/**'],
      enabled: false,
    },
    {
      matchDatasources: ['docker'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'container image updates',
      groupSlug: 'container-images',
    },
    {
      matchDatasources: ['helm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'Helm chart updates',
      groupSlug: 'helm-charts',
    },
    {
      matchManagers: ['kubernetes', 'kustomize', 'flux', 'custom.regex'],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
  ],
  kubernetes: {
    managerFilePatterns: ['/^addrspace\\/.+\\.ya?ml$/'],
  },
  kustomize: {
    managerFilePatterns: [
      '/^addrspace\\/kustomization\\.ya?ml$/',
      '/^addrspace\\/.+\\/kustomization\\.ya?ml$/',
    ],
  },
  flux: {
    managerFilePatterns: ['/^addrspace\\/clusters\\/addrspace\\/flux-system\\/gotk-components\\.ya?ml$/'],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Rancher HelmChart CR versions',
      managerFilePatterns: ['/^addrspace\\/.+\\.ya?ml$/'],
      matchStrings: [
        'repo:\\s*(?<registryUrl>https://[^\\s]+)\\s*\\n\\s*chart:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*version:\\s*(?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'helm',
      registryUrlTemplate: '{{{registryUrl}}}',
    },
    {
      customType: 'regex',
      description: 'Sealed Secrets versioned controller manifest',
      managerFilePatterns: ['/^addrspace\\/controllers\\/kustomization\\.yaml$/'],
      matchStrings: [
        'https://github\\.com/bitnami-labs/sealed-secrets/releases/download/v(?<currentValue>[^/]+)/controller\\.yaml',
      ],
      depNameTemplate: 'bitnami-labs/sealed-secrets',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Anvil main base and all three successful-build images at one commit',
      managerFilePatterns: ['/^addrspace\\/apps\\/anvil\\/kustomization\\.yaml$/'],
      matchStrings: [
         '(?<prefix>github\\.com/blogle/anvil//k8s/base\\?ref=)(?<currentDigest>[a-f0-9]{40})(?<afterBase>\\s*\\n\\s*-\\s*certificate\\.yaml\\s*\\n\\s*-\\s*ingress\\.yaml\\s*\\n\\s*-\\s*github-app-credentials-anvil\\.sealed\\.yaml\\s*\\n\\s*\\nimages:\\s*\\n\\s*-\\s*name:\\s*ghcr\\.io/blogle/anvil\\s*\\n\\s*newTag:\\s*sha-)[a-f0-9]{40}(?<afterApp>\\s*\\n\\s*-\\s*name:\\s*ghcr\\.io/blogle/anvil-sandbox\\s*\\n\\s*newTag:\\s*sha-)[a-f0-9]{40}(?<afterSandbox>\\s*\\n\\s*-\\s*name:\\s*ghcr\\.io/blogle/anvil-nix-daemon\\s*\\n\\s*newTag:\\s*)(?<daemonQuote>\\\"?)sha-[a-f0-9]{40}(?<suffix>\\\"?\\s*)',
      ],
      autoReplaceStringTemplate: '{{{prefix}}}{{{newDigest}}}{{{afterBase}}}{{{newDigest}}}{{{afterApp}}}{{{newDigest}}}{{{afterSandbox}}}{{{daemonQuote}}}sha-{{{newDigest}}}{{{suffix}}}',
      depNameTemplate: 'blogle/anvil',
      packageNameTemplate: 'https://github.com/blogle/anvil',
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
    },
    {
      customType: 'regex',
      description: 'Dojo staging base, semantic release version, and immutable release image',
      managerFilePatterns: ['/^addrspace\\/apps\\/dojo\\/overlays\\/staging\\/kustomization\\.yaml$/'],
      matchStrings: [
        '(?<prefix>github\\.com/blogle/dojo2//deploy/k8s/base\\?ref=)(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?<middle>\\s*\\n\\s*-\\s*namespace\\.yaml\\s*\\n\\s*-\\s*ingress\\.yaml\\s*\\n\\s*-\\s*dojo-google-oauth-sealed\\.yaml\\s*\\n\\s*\\nimages:\\s*\\n\\s*-\\s*name:\\s*ghcr\\.io/blogle/dojo2\\s*\\n\\s*newName:\\s*ghcr\\.io/blogle/dojo2\\s*\\n\\s*newTag:\\s*)v[0-9]+\\.[0-9]+\\.[0-9]+(?<digestPrefix>\\s*\\n\\s*digest:\\s*)(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      autoReplaceStringTemplate: '{{{prefix}}}{{{newValue}}}{{{middle}}}{{{newValue}}}{{{digestPrefix}}}{{{newDigest}}}',
      depNameTemplate: 'ghcr.io/blogle/dojo2',
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'Anvil-vendored Agent Sandbox release manifest at immutable main commit',
      managerFilePatterns: ['/^addrspace\\/controllers\\/agent-sandbox\\/kustomization\\.yaml$/'],
      matchStrings: [
        '(?<prefix>raw\\.githubusercontent\\.com/blogle/anvil/)(?<currentDigest>[a-f0-9]{40})(?<suffix>\\/k8s/vendor/agent-sandbox/)',
      ],
      autoReplaceStringTemplate: '{{{prefix}}}{{{newDigest}}}{{{suffix}}}',
      depNameTemplate: 'blogle/anvil-agent-sandbox',
      packageNameTemplate: 'https://github.com/blogle/anvil',
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
    },
  ],
}